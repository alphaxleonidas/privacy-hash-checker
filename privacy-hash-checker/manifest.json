{
  "manifest_version": 2,
  "name": "Privacy Hash Checker",
  "version": "2.3.3",
  "description": "Check file hashes with VirusTotal – Only hashes sent, no file uploads",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "contextMenus",
    "https://www.virustotal.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Privacy Hash Checker",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
